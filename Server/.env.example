# CodeHive Server Environment Variables
PORT=5000

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/codehive
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codehive?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/codehive

# JWT Secret for user session tokens
JWT_SECRET=codehive_jwt_secret_dev_key_987654321

# Google OAuth Client ID (Optional, if using Google login)
GOOGLE_CLIENT_ID=
